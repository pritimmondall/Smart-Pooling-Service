NODE_ENV=development
PORT=5001

# MongoDB Atlas connection string (required for multi-document ACID transactions)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartpool?retryWrites=true&w=majority
MONGODB_URI=

# Local DB Failover Configuration (development/testing only; strictly disabled in production)
ALLOW_LOCAL_DB_FALLBACK=true
MONGODB_FALLBACK_URI=mongodb://127.0.0.1:27017/smartpool?retryWrites=false

# JWT configuration
JWT_SECRET=replace_with_a_long_random_secret_before_running
JWT_EXPIRES_IN=7d

# Frontend Vite dev origin
CLIENT_ORIGIN=http://localhost:5173

# Phase 5A Route Optimization & Road Network Provider
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=5000
# GOOGLE_MAPS_API_KEY=your_key_here


# Estimated operating cost in INR per kilometer for route savings
TRAVEL_COST_PER_KM=10
